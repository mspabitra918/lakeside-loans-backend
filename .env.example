# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Mspabitra1@
DB_NAME=lakeside_loans
# DB_NAME_TEST=lakeside_loans_test

# Set true for managed Postgres that terminates TLS (RDS, Supabase, Neon...).
DB_SSL=false

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Frontend origin used to build verification links in emails.
FRONTEND_URL=http://localhost:3000

# SMTP delivery. Without these values, email attempts are recorded as skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=ZIPPY Cash

# Drip reminders use BullMQ/Redis. Run the backend as a long-lived process
# because serverless request handlers do not keep a queue worker running.
REDIS_URL=
DRIP_TEST_MODE=false
